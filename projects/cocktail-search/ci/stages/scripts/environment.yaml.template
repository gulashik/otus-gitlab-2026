# Apply this template through ci/stages/scripts/deploy-environment.sh. Values
# are intentionally visible so learners can inspect every workload relation.
apiVersion: v1
kind: Secret
metadata:
  name: cocktail-__ENVIRONMENT__-postgres-credentials
  namespace: __NAMESPACE__
type: Opaque
stringData:
  POSTGRES_DB: cocktail_catalog
  POSTGRES_USER: cocktail
  # Trusted-local teaching secret only; never reuse or commit real credentials.
  POSTGRES_PASSWORD: cocktail-local-only
---
apiVersion: v1
kind: Service
metadata:
  name: cocktail-__ENVIRONMENT__-postgres
  namespace: __NAMESPACE__
spec:
  clusterIP: None
  selector:
    app: cocktail-__ENVIRONMENT__-postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cocktail-__ENVIRONMENT__-postgres
  namespace: __NAMESPACE__
spec:
  serviceName: cocktail-__ENVIRONMENT__-postgres
  replicas: 1
  selector:
    matchLabels:
      app: cocktail-__ENVIRONMENT__-postgres
  template:
    metadata:
      labels:
        app: cocktail-__ENVIRONMENT__-postgres
    spec:
      containers:
        - name: postgres
          image: postgres:17.11-alpine3.24
          ports:
            - name: postgres
              containerPort: 5432
          envFrom:
            - secretRef:
                name: cocktail-__ENVIRONMENT__-postgres-credentials
          readinessProbe:
            exec:
              command: ["sh", "-c", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"]
            initialDelaySeconds: 5
            periodSeconds: 5
          volumeMounts:
            - name: cocktail-__ENVIRONMENT__-postgres-data
              mountPath: /var/lib/postgresql/data
  volumeClaimTemplates:
    - metadata:
        name: cocktail-__ENVIRONMENT__-postgres-data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cocktail-__ENVIRONMENT__-search
  namespace: __NAMESPACE__
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cocktail-__ENVIRONMENT__-search
  template:
    metadata:
      labels:
        app: cocktail-__ENVIRONMENT__-search
    spec:
      containers:
        - name: cocktail-search
          image: __APP_IMAGE_REF__
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: DB_HOST
              value: cocktail-__ENVIRONMENT__-postgres
            - name: DB_PORT
              value: "5432"
            - name: DB_NAME
              valueFrom:
                secretKeyRef:
                  name: cocktail-__ENVIRONMENT__-postgres-credentials
                  key: POSTGRES_DB
            - name: DB_USER
              valueFrom:
                secretKeyRef:
                  name: cocktail-__ENVIRONMENT__-postgres-credentials
                  key: POSTGRES_USER
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cocktail-__ENVIRONMENT__-postgres-credentials
                  key: POSTGRES_PASSWORD
          readinessProbe:
            httpGet:
              path: /actuator/health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /actuator/health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: cocktail-__ENVIRONMENT__-search
  namespace: __NAMESPACE__
spec:
  type: NodePort
  selector:
    app: cocktail-__ENVIRONMENT__-search
  ports:
    - name: http
      port: 8080
      targetPort: http
      nodePort: __NODE_PORT__
