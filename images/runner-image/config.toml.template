# This is a teaching template merged into a [[runners]] block by
# `gitlab-runner register --template-config`. URL, authentication token, name,
# tags, and untagged-job policy are supplied by GitLab and must not be stored
# in this version-controlled file.
concurrent = 2
check_interval = 0

[[runners]]
  executor = "docker"
  clone_url = "http://gitlab.local:8929"
  [runners.cache]
    Type = ""
  [runners.docker]
    host = "unix:///var/run/docker.sock"
    image = "alpine:3"
    privileged = false
    disable_cache = true
    volumes = ["/cache", "/var/run/docker.sock:/var/run/docker.sock", "/local/kubeconfig/deployer.conf:/etc/kubernetes/deployer.conf:ro"]
    # dockerd runs inside this Runner and owns the fixed 172.17.0.0/16 bridge.
    # Its gateway reaches the explicit Runner proxies without any host socket.
    extra_hosts = ["gitlab.local:172.17.0.1", "registry.localhost:172.17.0.1", "k3s.localhost:172.17.0.1"]
